{
  "entities": {
    "IddirConfig": {
      "title": "IddirConfig",
      "description": "Global association settings for Aleta Wendo Youth Mutual Aid Association.",
      "type": "object",
      "properties": {
        "associationName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "monthlyDuesAmount": { "type": "number" },
        "latePenaltyAmount": { "type": "number" },
        "version": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["associationName", "monthlyDuesAmount", "latePenaltyAmount", "version", "createdAt", "updatedAt"]
    },
    "IddirMember": {
      "title": "IddirMember",
      "description": "Registered Iddir member profile stored in /members/{memberId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberCode": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "kebeleOrSubcity": { "type": "string", "maxLength": 140 },
        "subCity": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kebele": { "type": "string", "minLength": 1, "maxLength": 60 },
        "addressNote": { "type": "string", "maxLength": 200 },
        "familyInfo": { "type": "string", "maxLength": 600 },
        "joinDate": { "type": "string", "minLength": 4, "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "photoUrl": { "type": "string", "maxLength": 350000 },
        "monthlyDuesRate": { "type": "number" },
        "guarantorName": { "type": "string", "maxLength": 100 },
        "dependents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "maxLength": 64 },
              "fullName": { "type": "string", "maxLength": 100 },
              "relationship": { "type": "string", "enum": ["spouse", "child", "parent", "sibling", "other"] },
              "age": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "memberCode", "fullName", "phone", "subCity", "kebele",
        "joinDate", "status", "monthlyDuesRate", "dependents", "createdAt", "updatedAt"
      ]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Admin-provisioned user credentials and 9-role RBAC assignments stored in /users/{userId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 60, "pattern": "^[a-z0-9_.\\-]+$" },
        "passwordSalt": { "type": "string", "minLength": 4, "maxLength": 64 },
        "passwordHash": { "type": "string", "minLength": 8, "maxLength": 128 },
        "role": {
          "type": "string",
          "enum": ["admin", "chairperson", "vice_chairperson", "treasurer", "secretary", "auditor", "public_relations", "committee_member", "member"]
        },
        "memberId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "isActive": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "passwordSalt", "passwordHash", "role", "fullName", "displayName", "isActive", "active", "createdAt", "updatedAt"]
    },
    "PaymentEntry": {
      "title": "PaymentEntry",
      "description": "Unified contribution and expense financial entry stored in /payments/{paymentId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "paymentType": { "type": "string", "enum": ["contribution", "expense"] },
        "receiptNumber": { "type": "string", "maxLength": 40 },
        "voucherNumber": { "type": "string", "maxLength": 40 },
        "memberId": { "type": "string", "maxLength": 128 },
        "memberCode": { "type": "string", "maxLength": 32 },
        "memberName": { "type": "string", "maxLength": 100 },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "monthKey": { "type": "string", "maxLength": 10 },
        "periodLabel": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["monthly", "bereavement", "penalty", "registration"] },
        "category": { "type": "string", "enum": ["bereavement_aid", "medical_aid", "wedding_gift", "operations", "equipment"] },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "beneficiaryName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["telebirr", "bank_transfer", "cash"] },
        "bankName": { "type": "string", "maxLength": 100 },
        "referenceCode": { "type": "string", "maxLength": 80 },
        "referenceNote": { "type": "string", "maxLength": 500 },
        "receiptImageUrl": { "type": "string", "maxLength": 450000 },
        "notes": { "type": "string", "maxLength": 500 },
        "submittedByMember": { "type": "boolean" },
        "authorizationStatus": { "type": "string", "enum": ["pending", "authorized", "rejected"] },
        "authorizedByUid": { "type": "string", "maxLength": 128 },
        "authorizedByName": { "type": "string", "maxLength": 100 },
        "authorizedAt": { "type": "string", "maxLength": 64 },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "approvedByName": { "type": "string", "maxLength": 100 },
        "recordedBy": { "type": "string", "maxLength": 100 },
        "recordedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recordedByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "recordedByRole": { "type": "string", "maxLength": 40 },
        "recordedAt": { "type": "string", "maxLength": 64 },
        "expenseDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "paymentType", "amount", "paymentMethod", "recordedBy", "recordedByUid",
        "recordedByName", "createdAt", "updatedAt"
      ]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Manual double-entry accounting journal entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entryNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 2, "maxLength": 300 },
        "sourceType": { "type": "string", "enum": ["contribution", "expense", "manual"] },
        "sourceId": { "type": "string", "maxLength": 128 },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accountCode": { "type": "string", "maxLength": 16 },
              "accountNameAm": { "type": "string", "maxLength": 120 },
              "debit": { "type": "number" },
              "credit": { "type": "number" }
            }
          }
        },
        "createdByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "authorizedByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "entryNumber", "date", "reference", "description", "sourceType", "lines", "createdByName", "createdAt", "updatedAt"]
    },
    "MeetingMinute": {
      "title": "MeetingMinute",
      "description": "Committee or general assembly meeting minutes and resolutions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "meetingNumber": { "type": "string", "minLength": 2, "maxLength": 60 },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "meetingDate": { "type": "string", "minLength": 4, "maxLength": 32 },
        "location": { "type": "string", "minLength": 2, "maxLength": 150 },
        "attendeesCount": { "type": "number" },
        "agenda": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "minutesBody": { "type": "string", "minLength": 2, "maxLength": 8000 },
        "decisions": { "type": "string", "maxLength": 4000 },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "approvedByName": { "type": "string", "maxLength": 100 },
        "recordedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recordedByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "meetingNumber", "title", "meetingDate", "location", "attendeesCount",
        "agenda", "minutesBody", "decisions", "approvalStatus", "recordedByUid", "recordedByName", "createdAt", "updatedAt"
      ]
    },
    "OfficialLetter": {
      "title": "OfficialLetter",
      "description": "Official correspondence issued by the Secretary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "letterNumber": { "type": "string", "minLength": 2, "maxLength": 60 },
        "recipient": { "type": "string", "minLength": 2, "maxLength": 160 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 200 },
        "body": { "type": "string", "minLength": 2, "maxLength": 6000 },
        "issueDate": { "type": "string", "minLength": 4, "maxLength": 32 },
        "memberId": { "type": "string", "maxLength": 128 },
        "issuedByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "letterNumber", "recipient", "subject", "body", "issueDate", "issuedByName", "createdAt", "updatedAt"]
    },
    "AnnouncementNotice": {
      "title": "AnnouncementNotice",
      "description": "Community announcements stored in /announcements/{announcementId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["bereavement", "joy", "urgent", "general"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "body": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "message": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "eventDate": { "type": "string", "maxLength": 32 },
        "location": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["draft", "approved", "published"] },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorUsername": { "type": "string", "maxLength": 60 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "authorRole": {
          "type": "string",
          "enum": ["admin", "chairperson", "vice_chairperson", "treasurer", "secretary", "auditor", "public_relations", "committee_member", "member"]
        },
        "approvedBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "title", "body", "message", "status", "approvalStatus", "authorUid", "authorName", "authorRole", "createdAt", "updatedAt"]
    },
    "MemberInquiry": {
      "title": "MemberInquiry",
      "description": "Member question submitted to Public Relations and official response.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "memberCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 160 },
        "message": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "responseText": { "type": "string", "maxLength": 2000 },
        "respondedByName": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["open", "responded"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "memberId", "memberName", "memberCode", "subject", "message", "status", "createdAt", "updatedAt"]
    },
    "CommitteeTask": {
      "title": "CommitteeTask",
      "description": "Committee coordination task and execution status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "assignedRole": { "type": "string", "enum": ["committee_member"] },
        "assignedToName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "dueDate": { "type": "string", "minLength": 4, "maxLength": 32 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "assignedRole", "assignedToName", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "BylawRule": {
      "title": "BylawRule",
      "description": "Iddir bylaw article and rule text.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "articleNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "content": { "type": "string", "minLength": 5, "maxLength": 5000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "articleNumber", "title", "content", "createdAt", "updatedAt"]
    },
    "AuditTrailEntry": {
      "title": "AuditTrailEntry",
      "description": "Append-only immutable audit trail log entry stored in /audit_logs/{logId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorUsername": { "type": "string", "minLength": 1, "maxLength": 60 },
        "actorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "actorRole": {
          "type": "string",
          "enum": ["admin", "chairperson", "vice_chairperson", "treasurer", "secretary", "auditor", "public_relations", "committee_member", "member"]
        },
        "performedBy": { "type": "string", "minLength": 1, "maxLength": 100 },
        "performedByRole": {
          "type": "string",
          "enum": ["admin", "chairperson", "vice_chairperson", "treasurer", "secretary", "auditor", "public_relations", "committee_member", "member"]
        },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "targetCollection": { "type": "string", "minLength": 1, "maxLength": 60 },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "minLength": 1, "maxLength": 60 },
        "details": { "type": "string", "minLength": 2, "maxLength": 500 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 500 },
        "timestamp": { "type": "string", "minLength": 4, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "actorUid", "actorUsername", "actorName", "actorRole",
        "performedBy", "performedByRole", "action", "targetCollection",
        "targetType", "details", "summary", "timestamp", "createdAt"
      ]
    }
  },
  "firestore": {
    "/iddir_config/{configId}": {
      "schema": { "$ref": "#/entities/IddirConfig" },
      "description": "Association global settings document."
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/IddirMember" },
      "description": "Registered Iddir members and covered dependents."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Admin-managed user accounts and 9-role assignments."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentEntry" },
      "description": "Contributions, bank receipt submissions, and expense disbursements."
    },
    "/iddir_journal_entries/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Manual double-entry accounting journal adjustments."
    },
    "/iddir_minutes/{minuteId}": {
      "schema": { "$ref": "#/entities/MeetingMinute" },
      "description": "Meeting minutes and committee resolutions."
    },
    "/iddir_letters/{letterId}": {
      "schema": { "$ref": "#/entities/OfficialLetter" },
      "description": "Official letters issued by the Secretary."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/AnnouncementNotice" },
      "description": "Public notices and community alerts."
    },
    "/iddir_inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/MemberInquiry" },
      "description": "Member inquiries and Public Relations responses."
    },
    "/iddir_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/CommitteeTask" },
      "description": "Committee member tasks."
    },
    "/iddir_bylaws/{bylawId}": {
      "schema": { "$ref": "#/entities/BylawRule" },
      "description": "Iddir bylaw articles."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditTrailEntry" },
      "description": "Immutable append-only audit trail."
    }
  }
}
