rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Primitives & RBAC Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticatedUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isVerified() {
      return isAuthenticatedUser() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'Misganalead28@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRequiredString(data, field, minLen, maxLen) {
      return (field in data) && data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isNonNegativeNumber(val) {
      return (val is int || val is float) && val >= 0;
    }

    function isPositiveNumber(val) {
      return (val is int || val is float) && val > 0;
    }

    function isValidRole(role) {
      return role in [
        'admin',
        'chairperson',
        'vice_chairperson',
        'treasurer',
        'secretary',
        'auditor',
        'public_relations',
        'committee_member',
        'member'
      ];
    }

    // =========================================================================
    // Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    // =========================================================================
    function isValidIddirConfig(data) {
      return data.keys().hasAll([
        'associationName', 'monthlyDuesAmount', 'latePenaltyAmount', 'version', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'associationName', 'monthlyDuesAmount', 'latePenaltyAmount', 'version', 'createdAt', 'updatedAt'
      ])
      && isValidRequiredString(data, 'associationName', 2, 160)
      && isPositiveNumber(data.monthlyDuesAmount)
      && isNonNegativeNumber(data.latePenaltyAmount)
      && (data.version is int || data.version is float)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidIddirMember(data) {
      return data.keys().hasAll([
        'id', 'memberCode', 'fullName', 'phone', 'subCity', 'kebele',
        'joinDate', 'status', 'monthlyDuesRate', 'dependents', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'memberCode', 'fullName', 'phone', 'address', 'kebeleOrSubcity',
        'subCity', 'kebele', 'addressNote', 'familyInfo', 'joinDate', 'status',
        'photoUrl', 'monthlyDuesRate', 'guarantorName', 'dependents', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'memberCode', 3, 32)
      && data.memberCode.matches('^[A-Z0-9\\-]+$')
      && isValidRequiredString(data, 'fullName', 2, 100)
      && isValidRequiredString(data, 'phone', 5, 30)
      && isValidOptionalString(data, 'address', 200)
      && isValidOptionalString(data, 'kebeleOrSubcity', 140)
      && isValidRequiredString(data, 'subCity', 1, 80)
      && isValidRequiredString(data, 'kebele', 1, 60)
      && isValidOptionalString(data, 'addressNote', 200)
      && isValidOptionalString(data, 'familyInfo', 600)
      && isValidRequiredString(data, 'joinDate', 4, 32)
      && data.status in ['active', 'suspended']
      && isValidOptionalString(data, 'photoUrl', 350000)
      && isNonNegativeNumber(data.monthlyDuesRate)
      && isValidOptionalString(data, 'guarantorName', 100)
      && data.dependents is list
      && data.dependents.size() <= 25
      && (data.dependents.size() == 0 || data.dependents[0] is map)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll([
        'id', 'username', 'passwordSalt', 'passwordHash', 'role', 'fullName', 'displayName',
        'isActive', 'active', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'username', 'passwordSalt', 'passwordHash', 'role', 'memberId',
        'fullName', 'displayName', 'isActive', 'active', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'username', 3, 60)
      && data.username.matches('^[a-z0-9_.\\-]+$')
      && isValidRequiredString(data, 'passwordSalt', 4, 64)
      && isValidRequiredString(data, 'passwordHash', 8, 128)
      && isValidRole(data.role)
      && isValidOptionalString(data, 'memberId', 128)
      && isValidRequiredString(data, 'fullName', 2, 100)
      && isValidRequiredString(data, 'displayName', 2, 100)
      && data.isActive is bool
      && data.active is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPaymentEntry(data) {
      return data.keys().hasAll([
        'id', 'paymentType', 'amount', 'paymentMethod', 'recordedBy', 'recordedByUid',
        'recordedByName', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'paymentType', 'receiptNumber', 'voucherNumber', 'memberId', 'memberCode',
        'memberName', 'month', 'year', 'monthKey', 'periodLabel', 'type', 'category',
        'title', 'description', 'beneficiaryName', 'amount', 'paymentMethod', 'bankName',
        'referenceCode', 'referenceNote', 'receiptImageUrl', 'notes', 'submittedByMember',
        'authorizationStatus', 'authorizedByUid', 'authorizedByName', 'authorizedAt',
        'rejectionReason', 'approvalStatus', 'approvedByName', 'recordedBy', 'recordedByUid',
        'recordedByName', 'recordedByRole', 'recordedAt', 'expenseDate', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.paymentType in ['contribution', 'expense']
      && isValidOptionalString(data, 'receiptNumber', 40)
      && isValidOptionalString(data, 'voucherNumber', 40)
      && isValidOptionalString(data, 'memberId', 128)
      && isValidOptionalString(data, 'memberCode', 32)
      && isValidOptionalString(data, 'memberName', 100)
      && (!('month' in data) || (data.month is int && data.month >= 1 && data.month <= 12))
      && (!('year' in data) || (data.year is int && data.year >= 2000 && data.year <= 2100))
      && isValidOptionalString(data, 'monthKey', 10)
      && isValidOptionalString(data, 'periodLabel', 64)
      && (!('type' in data) || data.type in ['monthly', 'bereavement', 'penalty', 'registration'])
      && (!('category' in data) || data.category in ['bereavement_aid', 'medical_aid', 'wedding_gift', 'operations', 'equipment'])
      && isValidOptionalString(data, 'title', 150)
      && isValidOptionalString(data, 'description', 1000)
      && isValidOptionalString(data, 'beneficiaryName', 100)
      && isPositiveNumber(data.amount)
      && data.paymentMethod in ['telebirr', 'bank_transfer', 'cash']
      && isValidOptionalString(data, 'bankName', 100)
      && isValidOptionalString(data, 'referenceCode', 80)
      && isValidOptionalString(data, 'referenceNote', 500)
      && isValidOptionalString(data, 'receiptImageUrl', 450000)
      && isValidOptionalString(data, 'notes', 500)
      && (!('submittedByMember' in data) || data.submittedByMember is bool)
      && (!('authorizationStatus' in data) || data.authorizationStatus in ['pending', 'authorized', 'rejected'])
      && isValidOptionalString(data, 'authorizedByUid', 128)
      && isValidOptionalString(data, 'authorizedByName', 100)
      && isValidOptionalString(data, 'authorizedAt', 64)
      && isValidOptionalString(data, 'rejectionReason', 300)
      && (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected'])
      && isValidOptionalString(data, 'approvedByName', 100)
      && isValidRequiredString(data, 'recordedBy', 1, 100)
      && isValidRequiredString(data, 'recordedByUid', 1, 128)
      && isValidRequiredString(data, 'recordedByName', 2, 100)
      && isValidOptionalString(data, 'recordedByRole', 40)
      && isValidOptionalString(data, 'recordedAt', 64)
      && isValidOptionalString(data, 'expenseDate', 32)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll([
        'id', 'entryNumber', 'date', 'reference', 'description', 'sourceType',
        'lines', 'createdByName', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'entryNumber', 'date', 'reference', 'description', 'sourceType',
        'sourceId', 'lines', 'createdByName', 'authorizedByName', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'entryNumber', 2, 40)
      && isValidRequiredString(data, 'date', 4, 32)
      && isValidRequiredString(data, 'reference', 1, 80)
      && isValidRequiredString(data, 'description', 2, 300)
      && data.sourceType in ['contribution', 'expense', 'manual']
      && isValidOptionalString(data, 'sourceId', 128)
      && data.lines is list
      && data.lines.size() >= 2
      && data.lines.size() <= 30
      && data.lines[0] is map
      && isValidRequiredString(data, 'createdByName', 2, 100)
      && isValidOptionalString(data, 'authorizedByName', 100)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMeetingMinute(data) {
      return data.keys().hasAll([
        'id', 'meetingNumber', 'title', 'meetingDate', 'location', 'attendeesCount',
        'agenda', 'minutesBody', 'decisions', 'approvalStatus', 'recordedByUid', 'recordedByName',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'meetingNumber', 'title', 'meetingDate', 'location', 'attendeesCount',
        'agenda', 'minutesBody', 'decisions', 'approvalStatus', 'approvedByName',
        'recordedByUid', 'recordedByName', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'meetingNumber', 2, 60)
      && isValidRequiredString(data, 'title', 2, 200)
      && isValidRequiredString(data, 'meetingDate', 4, 32)
      && isValidRequiredString(data, 'location', 2, 150)
      && isNonNegativeNumber(data.attendeesCount)
      && isValidRequiredString(data, 'agenda', 2, 2000)
      && isValidRequiredString(data, 'minutesBody', 2, 8000)
      && isValidOptionalString(data, 'decisions', 4000)
      && data.approvalStatus in ['pending', 'approved', 'rejected']
      && isValidOptionalString(data, 'approvedByName', 100)
      && isValidRequiredString(data, 'recordedByUid', 1, 128)
      && isValidRequiredString(data, 'recordedByName', 2, 100)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidOfficialLetter(data) {
      return data.keys().hasAll([
        'id', 'letterNumber', 'recipient', 'subject', 'body', 'issueDate', 'issuedByName', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'letterNumber', 'recipient', 'subject', 'body', 'issueDate', 'memberId', 'issuedByName', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'letterNumber', 2, 60)
      && isValidRequiredString(data, 'recipient', 2, 160)
      && isValidRequiredString(data, 'subject', 2, 200)
      && isValidRequiredString(data, 'body', 2, 6000)
      && isValidRequiredString(data, 'issueDate', 4, 32)
      && isValidOptionalString(data, 'memberId', 128)
      && isValidRequiredString(data, 'issuedByName', 2, 100)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAnnouncementNotice(data) {
      return data.keys().hasAll([
        'id', 'category', 'title', 'body', 'message', 'status', 'approvalStatus',
        'authorUid', 'authorName', 'authorRole', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'category', 'title', 'body', 'message', 'eventDate', 'location',
        'status', 'approvalStatus', 'authorUid', 'authorUsername', 'authorName',
        'authorRole', 'approvedBy', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.category in ['bereavement', 'joy', 'urgent', 'general']
      && isValidRequiredString(data, 'title', 2, 200)
      && isValidRequiredString(data, 'body', 2, 2000)
      && isValidRequiredString(data, 'message', 2, 2000)
      && isValidOptionalString(data, 'eventDate', 32)
      && isValidOptionalString(data, 'location', 150)
      && data.status in ['draft', 'approved', 'published']
      && data.approvalStatus in ['pending', 'approved', 'rejected']
      && isValidRequiredString(data, 'authorUid', 1, 128)
      && isValidOptionalString(data, 'authorUsername', 60)
      && isValidRequiredString(data, 'authorName', 2, 100)
      && isValidRole(data.authorRole)
      && isValidOptionalString(data, 'approvedBy', 100)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMemberInquiry(data) {
      return data.keys().hasAll([
        'id', 'memberId', 'memberName', 'memberCode', 'subject', 'message', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'memberId', 'memberName', 'memberCode', 'subject', 'message',
        'responseText', 'respondedByName', 'status', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'memberId', 1, 128)
      && isValidRequiredString(data, 'memberName', 2, 100)
      && isValidRequiredString(data, 'memberCode', 2, 32)
      && isValidRequiredString(data, 'subject', 2, 160)
      && isValidRequiredString(data, 'message', 2, 2000)
      && isValidOptionalString(data, 'responseText', 2000)
      && isValidOptionalString(data, 'respondedByName', 100)
      && data.status in ['open', 'responded']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCommitteeTask(data) {
      return data.keys().hasAll([
        'id', 'title', 'description', 'assignedRole', 'assignedToName', 'dueDate', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'title', 'description', 'assignedRole', 'assignedToName', 'dueDate', 'status', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'title', 2, 200)
      && isValidOptionalString(data, 'description', 2000)
      && data.assignedRole == 'committee_member'
      && isValidRequiredString(data, 'assignedToName', 2, 100)
      && isValidRequiredString(data, 'dueDate', 4, 32)
      && data.status in ['todo', 'in_progress', 'done']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidBylawRule(data) {
      return data.keys().hasAll([
        'id', 'articleNumber', 'title', 'content', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'articleNumber', 'title', 'content', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'articleNumber', 2, 40)
      && isValidRequiredString(data, 'title', 2, 200)
      && isValidRequiredString(data, 'content', 5, 5000)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAuditTrailEntry(data) {
      return data.keys().hasAll([
        'id', 'actorUid', 'actorUsername', 'actorName', 'actorRole',
        'performedBy', 'performedByRole', 'action', 'targetCollection',
        'targetType', 'details', 'summary', 'timestamp', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'actorUid', 'actorUsername', 'actorName', 'actorRole',
        'performedBy', 'performedByRole', 'action', 'targetCollection',
        'targetId', 'targetType', 'details', 'summary', 'timestamp', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidRequiredString(data, 'actorUid', 1, 128)
      && isValidRequiredString(data, 'actorUsername', 1, 60)
      && isValidRequiredString(data, 'actorName', 2, 100)
      && isValidRole(data.actorRole)
      && isValidRequiredString(data, 'performedBy', 1, 100)
      && isValidRole(data.performedByRole)
      && isValidRequiredString(data, 'action', 2, 120)
      && isValidRequiredString(data, 'targetCollection', 1, 60)
      && isValidOptionalString(data, 'targetId', 128)
      && isValidRequiredString(data, 'targetType', 1, 60)
      && isValidRequiredString(data, 'details', 2, 500)
      && isValidRequiredString(data, 'summary', 2, 500)
      && isValidRequiredString(data, 'timestamp', 4, 64)
      && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection Rules (Strict Verified Admin Isolation & Schema Guards)
    // =========================================================================
    match /iddir_config/{configId} {
      allow get: if isAdmin() && isValidId(configId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(configId) && isValidIddirConfig(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(configId) && isValidIddirConfig(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'associationName', 'monthlyDuesAmount', 'latePenaltyAmount', 'version', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(configId);
    }

    match /members/{memberId} {
      allow get: if isAdmin() && isValidId(memberId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(memberId) && isValidIddirMember(incoming())
        && incoming().id == memberId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(memberId) && isValidIddirMember(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'memberCode', 'fullName', 'phone', 'address', 'kebeleOrSubcity',
          'subCity', 'kebele', 'addressNote', 'familyInfo',
          'joinDate', 'status', 'photoUrl', 'monthlyDuesRate', 'guarantorName',
          'dependents', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(memberId);
    }

    match /users/{userId} {
      allow get: if isAdmin() && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(userId) && isValidUserAccount(incoming())
        && incoming().id == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(userId) && isValidUserAccount(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'passwordSalt', 'passwordHash', 'role', 'memberId',
          'fullName', 'displayName', 'isActive', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /payments/{paymentId} {
      allow get: if isAdmin() && isValidId(paymentId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(paymentId) && isValidPaymentEntry(incoming())
        && incoming().id == paymentId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(paymentId) && isValidPaymentEntry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'paymentType', 'receiptNumber', 'voucherNumber', 'memberId', 'memberCode',
          'memberName', 'month', 'year', 'monthKey', 'periodLabel', 'type', 'category',
          'title', 'description', 'beneficiaryName', 'amount', 'paymentMethod', 'bankName',
          'referenceCode', 'referenceNote', 'receiptImageUrl', 'notes', 'submittedByMember',
          'authorizationStatus', 'authorizedByUid', 'authorizedByName', 'authorizedAt',
          'rejectionReason', 'approvalStatus', 'approvedByName', 'recordedBy', 'recordedByUid',
          'recordedByName', 'recordedByRole', 'recordedAt', 'expenseDate', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(paymentId);
    }

    match /iddir_journal_entries/{entryId} {
      allow get: if isAdmin() && isValidId(entryId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(entryId) && isValidJournalEntry(incoming())
        && incoming().id == entryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(entryId) && isValidJournalEntry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'entryNumber', 'date', 'reference', 'description', 'sourceType',
          'sourceId', 'lines', 'createdByName', 'authorizedByName', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(entryId);
    }

    match /iddir_minutes/{minuteId} {
      allow get: if isAdmin() && isValidId(minuteId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(minuteId) && isValidMeetingMinute(incoming())
        && incoming().id == minuteId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(minuteId) && isValidMeetingMinute(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'meetingNumber', 'title', 'meetingDate', 'location', 'attendeesCount',
          'agenda', 'minutesBody', 'decisions', 'approvalStatus', 'approvedByName',
          'recordedByUid', 'recordedByName', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(minuteId);
    }

    match /iddir_letters/{letterId} {
      allow get: if isAdmin() && isValidId(letterId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(letterId) && isValidOfficialLetter(incoming())
        && incoming().id == letterId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(letterId) && isValidOfficialLetter(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'letterNumber', 'recipient', 'subject', 'body', 'issueDate', 'memberId', 'issuedByName', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(letterId);
    }

    match /announcements/{announcementId} {
      allow get: if isAdmin() && isValidId(announcementId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(announcementId) && isValidAnnouncementNotice(incoming())
        && incoming().id == announcementId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(announcementId) && isValidAnnouncementNotice(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'category', 'title', 'body', 'message', 'eventDate', 'location',
          'status', 'approvalStatus', 'authorUid', 'authorUsername', 'authorName',
          'authorRole', 'approvedBy', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    match /iddir_inquiries/{inquiryId} {
      allow get: if isAdmin() && isValidId(inquiryId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(inquiryId) && isValidMemberInquiry(incoming())
        && incoming().id == inquiryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(inquiryId) && isValidMemberInquiry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'memberId', 'memberName', 'memberCode', 'subject', 'message',
          'responseText', 'respondedByName', 'status', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    match /iddir_tasks/{taskId} {
      allow get: if isAdmin() && isValidId(taskId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(taskId) && isValidCommitteeTask(incoming())
        && incoming().id == taskId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(taskId) && isValidCommitteeTask(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'assignedRole', 'assignedToName', 'dueDate', 'status', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(taskId);
    }

    match /iddir_bylaws/{bylawId} {
      allow get: if isAdmin() && isValidId(bylawId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(bylawId) && isValidBylawRule(incoming())
        && incoming().id == bylawId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(bylawId) && isValidBylawRule(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'articleNumber', 'title', 'content', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(bylawId);
    }

    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAuditTrailEntry(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
